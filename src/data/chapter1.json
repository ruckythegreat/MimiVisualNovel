[
  {
    "id": "guide-schema",
    "type": "guide",
    "_comment": [
      "Gunakan stage.reset=true untuk membersihkan semua karakter/objek sebelum menggambar adegan baru.",
      "stage.background bisa string cepat atau object { image, overlay, transition:{type, duration} } untuk kontrol fade/slide.",
      "stage.characters adalah array snapshot. Properti populer: id (wajib), name, image (public/assets/sprites), position (left|center|right|custom), movement, scale, layer, isSpeaking, assetType.",
      "stage.objects bekerja sama seperti characters untuk benda atau foto narator. Dapat mengatur assetType:'bg' untuk pakai folder lain.",
      "Gunakan speakerId untuk menunjuk karakter yang sedang bicara. Jika tidak ada, engine pakai field name/speakerName.",
      "transition di level line memaksa animasi (string singkat atau object). Stage background/character change juga dapat memicu fade otomatis.",
      "choices[].jumpTo melompat ke id line lain. choices[].result menerima 'lose' (munculkan LoseOverlay) atau kata lain (lanjut biasa).",
      "question line memakai correctAnswer/hint (lihat komponen AnswerBox) namun tidak digunakan di contoh ini.",
      "Gunakan objek _comment tambahan jika ingin mendokumentasikan custom helper di JSON tanpa mengganggu engine."
    ]
  },
